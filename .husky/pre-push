#!/usr/bin/env sh

set -e

if ! command -v trivy >/dev/null 2>&1; then
  echo "pre-push: trivy not found, skipping security scan"
  echo "install trivy locally to enable vulnerability checks before push"
else
  npm run security:scan:hook
fi

echo "Running npm audit (pre-push)..."
npm run security:scan:audit

echo "Running jest tests (pre-push)..."
npm test

echo "Running Playwright e2e tests (pre-push)..."
npm run test:e2e