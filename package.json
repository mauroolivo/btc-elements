{
  "name": "btc-elements",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern='\\.unit\\.' --coverage",
    "test:functional": "jest --testPathPattern='\\.functional\\.' --coverage",
    "test:changed": "jest --onlyChanged --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:setup-auth": "playwright test --project=setup-auth",
    "test:e2e:auth": "playwright test --project=chromium-auth",
    "security:scan": "trivy fs --scanners vuln --severity HIGH,CRITICAL --exit-code 1 --pkg-types library .",
    "security:scan:hook": "node ./scripts/trivyPrePush.mjs",
    "prepare": "node -e \"if (process.env.CI === 'true' || process.env.NODE_ENV === 'production') process.exit(0); import('husky').then((mod) => mod.default()).catch(() => process.exit(0))\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "chart.js": "^4.5.1",
    "firebase": "^12.16.0",
    "immer": "^10.2.0",
    "next": "^16.2.11",
    "react": "19.2.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.82.0",
    "react-qr-code": "^2.2.0",
    "swr": "^2.4.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@axe-core/react": "^4.12.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
